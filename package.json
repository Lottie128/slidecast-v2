{
  "name": "slidecast-v2",
  "version": "2.3.0",
  "description": "AI-Powered Video Presentation Platform with React 18 & TypeScript",
  "type": "module",
  "scripts": {
    "dev": "bun run dev:server & bun run dev:client",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build",
    "build:server": "bun build src/server/index.ts --outdir dist/server --target node",
    "postinstall": "bun run build",
    "start": "test -f dist/server/index.js || bun run build; NODE_ENV=production bun dist/server/index.js",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "lucide-react": "^0.294.0",
    "axios": "^1.6.2",
    "@tanstack/react-query": "^5.14.2",
    "zustand": "^4.4.7",
    "zod": "^3.22.4",
    "cmdk": "^0.2.0",
    "framer-motion": "^10.16.16",
    "puppeteer": "^21.7.0",
    "fluent-ffmpeg": "^2.1.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.5",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}