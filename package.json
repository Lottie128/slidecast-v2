{
  "name": "slidecast-v2",
  "version": "1.0.0",
  "description": "AI-Powered Video Presentation Platform - Transform text into professional AI-narrated videos",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server/server.ts",
    "dev:client": "vite",
    "dev:server": "bun run --hot src/server/server.ts",
    "build": "vite build && tsc --noEmit",
    "build:client": "vite build",
    "build:server": "tsc --noEmit",
    "start": "bun src/server/server.ts",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "bun test",
    "db:migrate": "bun scripts/migrate.ts",
    "setup:tts": "pip install edge-tts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.21.0",
    "zustand": "^4.4.7",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "pg": "^8.11.0",
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.0",
    "sharp": "^0.33.0",
    "axios-retry": "^3.8.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^11.0.0",
    "react-beautiful-dnd": "^13.1.1",
    "fabric": "^5.3.0",
    "@google/genai": "^1.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5.3.3",
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.0",
    "@types/pg": "^8.11.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcrypt": "^5.0.0",
    "@types/react-beautiful-dnd": "^13.1.8",
    "typescript": "^5.3.0",
    "tailwindcss": "^3.4.0",
    "@tailwindcss/vite": "^4.0.0-alpha.25",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.0",
    "@testing-library/react": "^14.1.0",
    "bun-types": "latest",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  }
}
